{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"Benchmark Input Manifest",
  "type":"object",
  "additionalProperties":false,
  "required":["artifact_type","schema_version","benchmark_id","attachments"],
  "properties":{
    "artifact_type":{"const":"BenchmarkInputManifest"},
    "schema_version":{"const":"1.0"},
    "benchmark_id":{"type":"string","minLength":1},
    "attachments":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["attachment_id","required","status"],"properties":{
      "attachment_id":{"type":"string","minLength":1},
      "required":{"type":"boolean"},
      "status":{"enum":["PRESENT","MISSING","INVALID"]},
      "path":{"type":"string"},
      "sha256":{"type":"string","pattern":"^[0-9a-fA-F]{64}$"},
      "media_type":{"type":"string"}
    }}}
  }
}