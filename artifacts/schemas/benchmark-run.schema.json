{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"Benchmark Run",
  "type":"object",
  "additionalProperties":false,
  "required":["artifact_type","schema_version","benchmark_id","status","stages","gate_decision"],
  "properties":{
    "artifact_type":{"const":"BenchmarkRun"},
    "schema_version":{"const":"1.0"},
    "benchmark_id":{"type":"string","minLength":1},
    "status":{"enum":["READY","BLOCKED","RUNNING","COMPLETED","FAILED"]},
    "stages":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["stage_id","status"],"properties":{
      "stage_id":{"type":"string","minLength":1},
      "status":{"enum":["READY","BLOCKED","RUNNING","COMPLETED","FAILED"]},
      "message":{"type":"string"},
      "input_refs":{"type":"array","items":{"type":"string"}},
      "output_refs":{"type":"array","items":{"type":"string"}}
    }}},
    "input_manifest_ref":{"type":["string","null"]},
    "run_id":{"type":["string","null"]},
    "gate_decision":{"enum":["PASS","FAIL","NOT_RUN"]}
  }
}