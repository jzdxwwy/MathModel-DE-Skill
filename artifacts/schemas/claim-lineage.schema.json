{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://github.com/jzdxwwy/MathModel-DE-Skill/blob/main/artifacts/schemas/claim-lineage.schema.json",
  "title":"Claim Lineage","type":"object","additionalProperties":false,
  "required":["artifact_type","schema_version","status","claims"],
  "properties":{
    "artifact_type":{"const":"ClaimLineage"},"schema_version":{"const":"1.0-O"},
    "status":{"enum":["DRAFT","VALIDATED","FROZEN","SUPERSEDED"]},"run_id":{"type":"string"},
    "gate_decision":{"enum":["PASS","FAIL","NOT_RUN"]},"violations":{"type":"array","items":{"type":"string"}},
    "claims":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,
      "required":["claim_id","statement","nodes","edges"],
      "properties":{
        "claim_id":{"type":"string","minLength":1},"statement":{"type":"string","minLength":1},
        "nodes":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,
          "required":["node_id","node_type","ref"],"properties":{
            "node_id":{"type":"string"},"node_type":{"enum":["CLAIM","PAPER_EVIDENCE","RESULT","VERIFICATION","PRESENTATION","UNIFIED_EXECUTION_EVIDENCE","INPUT"]},"ref":{"type":"string"}}}},
        "edges":{"type":"array","items":{"type":"object","additionalProperties":false,
          "required":["from","to","relation"],"properties":{"from":{"type":"string"},"to":{"type":"string"},"relation":{"type":"string"}}}},
        "observations":{"type":"array","items":{"type":"object","additionalProperties":false,
          "required":["observation_id","source_ref","comparison_type","value"],
          "properties":{"observation_id":{"type":"string"},"source_ref":{"type":"string"},"comparison_type":{"enum":["numeric","exact","none"]},"value":{},"unit":{"type":"string"},"atol":{"type":"number","minimum":0},"rtol":{"type":"number","minimum":0},"normalized_value":{"type":"string"}}}},
        "figure_refs":{"type":"array","items":{"type":"string"}},"table_refs":{"type":"array","items":{"type":"string"}},"equation_refs":{"type":"array","items":{"type":"string"}}
      }}}
  }
}