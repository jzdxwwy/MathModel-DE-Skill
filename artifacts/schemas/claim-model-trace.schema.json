        "claim_id":{"type":"string"},"model_id":{"type":"string"},
        "equation_bindings":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["claim_ref","model_ref","normalized_match"],"properties":{"claim_ref":{"type":"string"},"model_ref":{"type":"string"},"normalized_match":{"type":"boolean"},"claim_expression_hash":{"type":"string"},"model_expression_hash":{"type":"string"}}}},
        "parameter_bindings":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["symbol","claim_value","model_value","comparison"],"properties":{"symbol":{"type":"string"},"claim_value":{},"model_value":{},"unit":{"type":"string"},"comparison":{"enum":["MATCH","MISMATCH","MISSING","NOT_COMPARABLE"]},"atol":{"type":"number"},"rtol":{"type":"number"}}}},
