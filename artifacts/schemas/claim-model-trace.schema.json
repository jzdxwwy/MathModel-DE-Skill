{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"ClaimModelTrace","type":"object","additionalProperties":false,
  "required":["artifact_type","schema_version","status","run_id","claims","gate_decision","violations"],
  "properties":{
    "artifact_type":{"const":"ClaimModelTrace"},"schema_version":{"const":"1.0-S"},
    "status":{"enum":["DRAFT","VALIDATED","FROZEN","SUPERSEDED"]},"run_id":{"type":"string"},
    "claims":{"type":"array","items":{"type":"object","additionalProperties":false,
      "required":["claim_id","model_id","equation_bindings","parameter_bindings","trace_status"],
