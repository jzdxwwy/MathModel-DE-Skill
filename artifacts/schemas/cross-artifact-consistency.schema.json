{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cross Artifact Consistency Report",
  "type": "object",
  "required": ["artifact_type", "schema_version", "run_id", "gate_decision", "checks", "blocking_failures"],
  "properties": {
    "artifact_type": {"const": "CrossArtifactConsistencyReport"},
    "schema_version": {"const": "1.0-B"},
    "run_id": {"type": "string", "minLength": 1},
    "gate_decision": {"enum": ["PASS", "FAIL", "NOT_RUN"]},
    "checks": {"type": "array", "items": {"type": "object", "required": ["check_id", "status", "evidence"], "properties": {"check_id": {"type": "string"}, "status": {"enum": ["PASS", "FAIL", "NOT_RUN"]}, "evidence": {"type": "string"}}, "additionalProperties": false}},
    "blocking_failures": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
