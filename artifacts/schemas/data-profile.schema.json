{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jzdxwwy/MathModel-DE-Skill/blob/main/artifacts/schemas/data-profile.schema.json",
  "title": "DataProfile",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_type", "schema_version", "status", "assets"],
  "properties": {
    "artifact_type": {"const": "DataProfile"},
    "schema_version": {"type": "string"},
    "status": {"enum": ["DRAFT", "VALIDATED", "FROZEN", "SUPERSEDED"]},
    "assets": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["asset_id", "format", "size", "quality"], "properties": {
      "asset_id": {"type": "string"},
      "path_or_ref": {"type": "string"},
      "format": {"type": "string"},
      "size": {"type": "object", "additionalProperties": false, "properties": {"rows": {"type": "integer", "minimum": 0}, "columns": {"type": "integer", "minimum": 0}, "bytes": {"type": "integer", "minimum": 0}}},
      "schema": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["name", "dtype"], "properties": {"name": {"type": "string"}, "dtype": {"type": "string"}, "role": {"type": "string"}, "missing_rate": {"type": "number", "minimum": 0, "maximum": 1}, "unique_rate": {"type": "number", "minimum": 0, "maximum": 1}}}},
      "quality": {"type": "object", "additionalProperties": false, "required": ["missing", "duplicates", "anomalies"], "properties": {"missing": {"type": "string"}, "duplicates": {"type": "string"}, "anomalies": {"type": "string"}}},
      "time_range": {"type": "object", "additionalProperties": false, "properties": {"start": {"type": "string"}, "end": {"type": "string"}}},
      "relationships": {"type": "array", "items": {"type": "string"}}
    }}},
    "data_risks": {"type": "array", "items": {"type": "string"}},
    "gate_decision": {"enum": ["PASS", "PASS_WITH_WARNINGS", "FAIL"]}
  }
}