{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EnvironmentGateReport",
  "type": "object",
  "required": ["artifact_type", "schema_version", "run_id", "reference_fingerprint", "rebuild_fingerprint", "checks", "mismatches", "gate_decision"],
  "properties": {
    "artifact_type": {"const": "EnvironmentGateReport"},
    "schema_version": {"const": "1.0-E"},
    "run_id": {"type": "string"},
    "reference_fingerprint": {"type": ["string", "null"]},
    "rebuild_fingerprint": {"type": ["string", "null"]},
    "checks": {"type": "array", "items": {"type": "object", "required": ["check_id", "decision"], "properties": {"check_id": {"type": "string"}, "decision": {"enum": ["PASS", "FAIL", "NOT_RUN"]}, "message": {"type": "string"}}}},
    "mismatches": {"type": "array", "items": {"type": "string"}},
    "gate_decision": {"enum": ["PASS", "FAIL", "NOT_RUN"]}
  }
}
