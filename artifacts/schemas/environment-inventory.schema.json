{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EnvironmentInventory",
  "type":"object",
  "required":["artifact_type","schema_version","interpreter","python","packages","fingerprint"],
  "properties":{
    "artifact_type":{"const":"EnvironmentInventory"},
    "schema_version":{"const":"1.0-J"},
    "interpreter":{"type":"string","minLength":1},
    "python":{"type":"object","required":["implementation","version"],"additionalProperties":false,"properties":{"implementation":{"type":"string"},"version":{"type":"string"}}},
    "packages":{"type":"array","items":{"type":"object","required":["name","version"],"additionalProperties":false,"properties":{"name":{"type":"string"},"version":{"type":"string"}}}},
    "fingerprint":{"type":"string","pattern":"^[a-f0-9]{64}$"}
  },
  "additionalProperties":false
}