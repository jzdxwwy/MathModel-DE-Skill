{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jzdxwwy/MathModel-DE-Skill/blob/main/artifacts/schemas/model-spec.schema.json",
  "title": "ModelSpec",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_type", "schema_version", "status", "model_id", "task_id", "objective", "variables", "equations", "assumptions", "validation_plan"],
  "properties": {
    "artifact_type": {"const": "ModelSpec"},
    "schema_version": {"type": "string"},
    "status": {"enum": ["DRAFT", "VALIDATED", "FROZEN", "SUPERSEDED"]},
    "model_id": {"type": "string"},
    "task_id": {"type": "string"},
    "name": {"type": "string"},
    "objective": {"type": "string"},
    "variables": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["symbol", "role", "meaning"], "properties": {"symbol": {"type": "string"}, "role": {"enum": ["input", "decision", "state", "target", "parameter", "derived"]}, "meaning": {"type": "string"}, "unit": {"type": "string"}}}},
    "parameters": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["symbol", "meaning", "source"], "properties": {"symbol": {"type": "string"}, "meaning": {"type": "string"}, "value": {}, "source": {"type": "string"}}}},
    "equations": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "constraints": {"type": "array", "items": {"type": "string"}},
    "assumptions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "solution_method": {"type": "string"},
    "validation_plan": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "limitations": {"type": "array", "items": {"type": "string"}}
  }
}