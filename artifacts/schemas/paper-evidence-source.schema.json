{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"PaperEvidenceSource",
  "type":"object","additionalProperties":false,
  "required":["artifact_type","schema_version","evidence_id","source_type","unified_execution_evidence_ref"],
  "properties":{
    "artifact_type":{"const":"PaperEvidenceSource"},
    "schema_version":{"const":"1.0-N"},
    "evidence_id":{"type":"string","minLength":1},
    "source_type":{"enum":["RESULT","FIGURE","TABLE","EQUATION","CLAIM"]},
    "unified_execution_evidence_ref":{"type":"string","minLength":1},
    "result_bundle_ref":{"type":"string","minLength":1},
    "run_id":{"type":"string","minLength":1}
  }
}