{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jzdxwwy/MathModel-DE-Skill/blob/main/artifacts/schemas/paper-evidence.schema.json",
  "title": "PaperEvidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_type", "schema_version", "status", "claims"],
  "properties": {
    "artifact_type": {"const": "PaperEvidence"},
    "schema_version": {"const": "0.9-K"},
    "status": {"enum": ["DRAFT", "VALIDATED", "FROZEN", "SUPERSEDED"]},
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim_id", "statement", "evidence_refs", "verification_refs", "result_refs", "lineage_refs"],
        "properties": {
          "claim_id": {"type": "string"},
          "statement": {"type": "string", "minLength": 1},
          "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "verification_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "result_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "lineage_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "unified_execution_evidence_refs": {"type": "array", "items": {"type": "string"}},
          "observations": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["observation_id", "source_ref", "comparison_type", "value"], "properties": {"observation_id": {"type": "string"}, "source_ref": {"type": "string"}, "comparison_type": {"enum": ["numeric", "exact", "none"]}, "value": {}, "unit": {"type": "string"}, "atol": {"type": "number", "minimum": 0}, "rtol": {"type": "number", "minimum": 0}, "normalized_value": {"type": "string"}}}},
          "figure_refs": {"type": "array", "items": {"type": "string"}},
          "table_refs": {"type": "array", "items": {"type": "string"}},
          "equation_refs": {"type": "array", "items": {"type": "string"}},
          "equation_observations": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["expression"], "properties": {"expression": {"type": "string"}, "claim_ref": {"type": "string"}, "model_ref": {"type": "string"}}}},
          "parameter_observations": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["symbol", "value"], "properties": {"symbol": {"type": "string"}, "value": {}, "unit": {"type": "string"}, "claim_value": {}, "source_ref": {"type": "string"}}}},
          "confidence": {"enum": ["high", "medium", "low"]}
        }
      }
    },
    "citation_policy": {"type": "string"},
    "unsupported_claims": {"type": "array", "items": {"type": "string"}}
  }
}
