{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jzdxwwy/MathModel-DE-Skill/blob/main/artifacts/schemas/paper-evidence.schema.json",
  "title": "PaperEvidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_type", "schema_version", "status", "claims"],
  "properties": {
    "artifact_type": {"const": "PaperEvidence"},
    "schema_version": {"const": "0.9-K"},
    "status": {"enum": ["DRAFT", "VALIDATED", "FROZEN", "SUPERSEDED"]},
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim_id", "statement", "evidence_refs", "verification_refs", "result_refs", "lineage_refs"],
        "properties": {
          "claim_id": {"type": "string"},
          "statement": {"type": "string", "minLength": 1},
          "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "verification_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "result_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "lineage_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "figure_refs": {"type": "array", "items": {"type": "string"}},
          "table_refs": {"type": "array", "items": {"type": "string"}},
          "equation_refs": {"type": "array", "items": {"type": "string"}},
          "confidence": {"enum": ["high", "medium", "low"]}
        }
      }
    },
    "citation_policy": {"type": "string"},
    "unsupported_claims": {"type": "array", "items": {"type": "string"}}
  }
}
