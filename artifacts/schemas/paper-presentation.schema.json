{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jzdxwwy/MathModel-DE-Skill/blob/main/artifacts/schemas/paper-presentation.schema.json",
  "title": "PaperPresentationEvidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_type", "schema_version", "figures", "tables", "equations"],
  "properties": {
    "artifact_type": {"const": "PaperPresentationEvidence"},
    "schema_version": {"type": "string"},
    "figures": {"type": "array", "items": {"$ref": "#/$defs/item"}},
    "tables": {"type": "array", "items": {"$ref": "#/$defs/item"}},
    "equations": {"type": "array", "items": {"$ref": "#/$defs/item"}}
  },
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_id", "source_refs", "result_refs", "verification_refs", "lineage_refs"],
      "properties": {
        "evidence_id": {"type": "string"},
        "source_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "result_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "verification_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "lineage_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "description": {"type": "string"},
        "render_ref": {"type": "string"}
      }
    }
  }
}
