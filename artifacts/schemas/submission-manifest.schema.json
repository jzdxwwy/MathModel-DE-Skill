{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Submission Manifest",
  "type": "object",
  "required": ["artifact_type", "schema_version", "run_id", "artifacts", "gate_decision"],
  "properties": {
    "artifact_type": {"const": "SubmissionManifest"},
    "schema_version": {"const": "0.9-N"},
    "run_id": {"type": "string", "minLength": 1},
    "problem_hash": {"type": ["string", "null"]},
    "attachment_hashes": {"type": "array", "items": {"type": "string"}},
    "git_commit": {"type": ["string", "null"]},
    "environment": {"type": "object"},
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "path", "sha256"],
        "properties": {
          "kind": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "minLength": 64, "maxLength": 64}
        },
        "additionalProperties": false
      }
    },
    "paper_manifest_ref": {"type": ["string", "null"]},
    "presentation_manifest_ref": {"type": ["string", "null"]},
    "render_manifest_refs": {"type": "array", "items": {"type": "string"}},
    "verification_report_refs": {"type": "array", "items": {"type": "string"}},
    "gate_decision": {"enum": ["PASS", "FAIL", "NOT_RUN"]}
  },
  "additionalProperties": false
}
