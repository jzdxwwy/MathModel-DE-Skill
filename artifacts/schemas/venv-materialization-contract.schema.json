{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VenvMaterializationContract",
  "type": "object",
  "required": ["artifact_type", "schema_version", "materialization_id", "adapter_id", "python", "target_dir", "fresh", "policy", "lock_hash"],
  "properties": {
    "artifact_type": {"const": "VenvMaterializationContract"},
    "schema_version": {"const": "1.0-I"},
    "materialization_id": {"type": "string", "minLength": 1},
    "adapter_id": {"type": "string", "minLength": 1},
    "python": {"type": "object", "required": ["implementation", "version"], "properties": {"implementation": {"type": "string"}, "version": {"type": "string"}}, "additionalProperties": false},
    "target_dir": {"type": "string", "minLength": 1},
    "fresh": {"const": true},
    "policy": {"type": "object", "required": ["allow_network", "allow_shell", "isolation_required"], "properties": {"allow_network": {"const": false}, "allow_shell": {"const": false}, "isolation_required": {"const": true}}, "additionalProperties": false},
    "lock_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "additionalProperties": false
}
