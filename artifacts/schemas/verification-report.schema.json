{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jzdxwwy/MathModel-DE-Skill/blob/main/artifacts/schemas/verification-report.schema.json",
  "title": "VerificationReport",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_type", "schema_version", "status", "run_id", "checks", "gate_decision"],
  "properties": {
    "artifact_type": {"const": "VerificationReport"},
    "schema_version": {"type": "string"},
    "status": {"enum": ["DRAFT", "VALIDATED", "FROZEN", "SUPERSEDED"]},
    "run_id": {"type": "string"},
    "checks": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["check_id", "category", "status", "evidence"], "properties": {"check_id": {"type": "string"}, "category": {"enum": ["data", "model", "numerical", "statistical", "sensitivity", "robustness", "provenance", "figure", "writing", "other"]}, "status": {"enum": ["PASS", "WARN", "FAIL", "NOT_RUN"]}, "evidence": {"type": "string"}, "metric": {}, "threshold": {}, "artifact_ref": {"type": "string"}}}},
    "gate_decision": {"enum": ["PASS", "PASS_WITH_WARNINGS", "FAIL"]},
    "critical_issues": {"type": "array", "items": {"type": "string"}},
    "recommendations": {"type": "array", "items": {"type": "string"}}
  }
}