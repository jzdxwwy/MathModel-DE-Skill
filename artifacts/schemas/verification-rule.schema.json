{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jzdxwwy/MathModel-DE-Skill/blob/main/artifacts/schemas/verification-rule.schema.json",
  "title": "VerificationAcceptanceRule",
  "type": "object",
  "additionalProperties": false,
  "required": ["rule_id", "version", "model_ids", "checks"],
  "properties": {
    "rule_id": {"type": "string"},
    "version": {"type": "string"},
    "model_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "checks": {"type": "array", "minItems": 1, "items": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check_id", "category", "evidence_policy"],
      "properties": {
        "check_id": {"type": "string"},
        "category": {"enum": ["data", "model", "numerical", "statistical", "sensitivity", "robustness", "provenance", "figure", "writing", "other"]},
        "evidence_policy": {"enum": ["required", "optional"]},
        "metric": {"type": "string"},
        "min": {"type": "number"},
        "max": {"type": "number"},
        "artifact": {"type": "string"}
      }
    }}
  }
}
